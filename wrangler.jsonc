{
  "name": "tata",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // Vytvoř: npx wrangler d1 create tata-db  → sem vlož vypsané database_id
    { "binding": "DB", "database_name": "tata-db", "database_id": "DOPLN-ID-Z-WRANGLER-D1-CREATE" }
  ]
  // Heslo: npx wrangler secret put APP_PASSWORD
}
