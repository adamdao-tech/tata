{
  "name": "tata",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // Databáze tata-db (vytvořená v Cloudflare dashboardu)
    { "binding": "DB", "database_name": "tata-db", "database_id": "ff93c17d-7e0b-4b48-8498-ef1ad631621d" }
  ]
  // Heslo: npx wrangler secret put APP_PASSWORD
}
